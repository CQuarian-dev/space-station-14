click-damage-modifier = Атаки лёгкие (левой кнопкой) { $arg ->
        [1] [color=green]на {$abs}% сильнее.[/color]
        *[other] [color=red]на {$abs}% слабее.[/color]
    }

heavy-damage-modifier = Атаки тяжёлые (правой кнопкой) { $arg ->
        [1] [color=green]на {$abs}% сильнее.[/color]
        *[other] [color=red]на {$abs}% слабее.[/color]
    }
