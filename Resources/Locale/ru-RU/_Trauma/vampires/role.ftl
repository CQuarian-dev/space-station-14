roles-antag-vampire-name = Вампир
roles-antag-vampire-objective = Пейте кровь экипажа и достигните полной силы.

# SIS-Start
vampire-role-greeting =
    Вы [gradient angle="65" spread="65" color1="{$hl1}" color2="{$hl2}" speed="1.5"]Вампир[/gradient], бессмертное дитя ночи и повелитель крови.
    Древний голод пробудился в ваших венах. Ваша цель: [gradient angle="65" spread="65" color1="{$hl1}" color2="{$hl2}" speed="1.2"]насытиться кровью экипажа[/gradient] и вернуть былое могущество.

vampire-role-greeting-desc =
    • [color={$hl1}]Охота и Укус:[/color] включите боевой режим, цельтесь в [color={$hl1}]голову[/color] и атакуйте жертву пустой рукой, чтобы пить её кровь.
    • [color={$hl1}]Тёмные Силы:[/color] чем больше свежей крови вы поглотите, тем больше сверхъестественных способностей откроется в вашем арсенале.
    • [color={$hl1}]Смертельные слабости:[/color] избегайте Священника станции, святой воды, Библий, огня и открытого космоса — они смертоносны для вашей плоти!

vampire-role-briefing = Пейте кровь экипажа (укус в голову пустой рукой), развивайте способности. Не выходите в космос и избегайте священника, церкви и особенно святой воды.
# SIS-End

